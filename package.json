{
  "name": "dsh-plugin-tether",
  "version": "0.1.25",
  "description": "Mobile client for the DeepSeek Harness — use the dsh on your dev machine from your Android or iOS phone, remotely across networks, peer-to-peer over iroh with no server to set up (falls back to a relay that only sees ciphertext)",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "android",
    "ios",
    "mobile",
    "remote",
    "p2p",
    "iroh"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zexadev/dsh-tether.git"
  },
  "homepage": "https://dsh-tether.zexa.cc/",
  "bugs": {
    "url": "https://github.com/zexadev/dsh-tether/issues"
  },
  "author": "zexadev",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "androidRuntime": {
      "node": "24.18.0",
      "dsh": "0.2.1-rc.2",
      "koffi": "3.3.0",
      "zod": "4.4.3"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.7 <0.1.1-0 || >=0.1.2-alpha.0 <0.1.3-0 || >=0.1.5-alpha.0 <0.1.8-0 || >=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0 || >=0.2.2-alpha.2 <0.2.3-0",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.7 <0.1.1-0 || >=0.1.2-alpha.0 <0.1.3-0 || >=0.1.5-alpha.0 <0.1.8-0 || >=0.2.0-rc.2 <0.2.1-0 || >=0.2.1-alpha.1 <0.2.2-0 || >=0.2.2-alpha.2 <0.2.3-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": { "optional": true },
    "@deepseek-ai/dsh-user-approval": { "optional": true }
  },
  "optionalDependencies": {
    "dsh-tether-host-android-arm64": "0.1.25",
    "dsh-tether-host-darwin-arm64": "0.1.25",
    "dsh-tether-host-darwin-x64": "0.1.25",
    "dsh-tether-host-linux-arm64": "0.1.25",
    "dsh-tether-host-linux-x64": "0.1.25",
    "dsh-tether-host-win32-x64": "0.1.25"
  }
}
